{
  "name": "lezhnev74/pasvl",
  "description": "Array Validator (regular expressions for nested array, sort of)",
  "keywords": [
    "validation",
    "validator",
    "array",
    "structure",
    "pattern"
  ],
  "authors": [
    {
      "name": "Dmitriy Lezhnev",
      "email": "lezhnev.work@gmail.com"
    }
  ],
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "roave/security-advisories": "dev-master",
    "phpstan/phpstan": "^2",
    "rector/rector": "^2",
    "friendsofphp/php-cs-fixer": "^3"
  },
  "autoload": {
    "psr-4": {
      "PASVL\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PASVL\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:fix": "php-cs-fixer fix",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "stan": "phpstan analyse",
    "rector": "rector process",
    "rector:check": "rector process --dry-run",
    "test": "phpunit",
    "qa": [
      "@cs:check",
      "@stan",
      "@rector:check",
      "@test"
    ]
  }
}
